{
  "name": "vue-viewports",
  "version": "4.1.0",
  "description": "Named, reactive, matchMedia-based viewport breakpoints for Vue 3 — a tiny plugin and composable.",
  "type": "module",
  "author": {
    "name": "Marco Boffo",
    "email": "marcoboffo.waves@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaccogatto/vue-viewports.git"
  },
  "homepage": "https://github.com/scaccogatto/vue-viewports#readme",
  "bugs": {
    "url": "https://github.com/scaccogatto/vue-viewports/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "viewport",
    "viewports",
    "responsive",
    "breakpoints",
    "media-query",
    "matchmedia",
    "composable",
    "plugin",
    "composition-api",
    "typescript",
    "vite"
  ],
  "sideEffects": false,
  "main": "./dist/vue-viewports.cjs",
  "module": "./dist/vue-viewports.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-viewports.js",
      "require": "./dist/vue-viewports.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && npm run typecheck-demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "build-demo": "vite build --config vite.config.demo.ts",
    "dev-demo": "vite --config vite.config.demo.ts",
    "typecheck-demo": "vue-tsc --noEmit -p tsconfig.demo.json"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=20"
  }
}
